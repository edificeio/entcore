{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["k6"],
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "it/scenarios/feeder/**/*.ts",
    "it/scenarios/directory/_aaf-*.ts"
  ],
  "exclude": [
    "it/scenarios/feeder/**/*.test.ts"
  ]
}
